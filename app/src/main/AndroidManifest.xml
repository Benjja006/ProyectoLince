<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso para conectarse a Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Southbound Sync"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SouthboundSync">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Southbound Sync"
            android:theme="@style/Theme.SouthboundSync">

            <!-- Permite abrir la app normalmente -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Recibir enlaces de inicio de sesión de Firebase -->
            <intent-filter android:autoVerify="true">

                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="proyectolince-d9ad8.firebaseapp.com"
                    android:pathPrefix="/__/auth/links" />

            </intent-filter>

        </activity>

    </application>

</manifest>
